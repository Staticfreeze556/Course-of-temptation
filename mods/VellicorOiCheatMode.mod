		&lt;&lt;if $cheatsenabled&gt;&gt;
			&lt;div class="storymenu-button-block"&gt;
				&lt;div class="two-column-container"&gt;
					&lt;div class="two-column"&gt;
						&lt;&lt;button &quot;Reroll RNG&quot;&gt;&gt;
							&lt;&lt;script&gt;&gt;
								State.restore(true);
								&lt;&lt;if (State.prng.isEnabled())&gt;&gt;
									State.random();
									const frame = State.history[State.activeIndex];
									frame.pull = State.prng.pull;
								&lt;&lt;/if&gt;&gt;
								Engine.show();
							&lt;&lt;/script&gt;&gt;
						&lt;&lt;/button&gt;&gt;
					&lt;/div&gt;
					&lt;div class="two-column"&gt;
						&lt;&lt;button &quot;Reset Needs&quot;&gt;&gt;
							&lt;&lt;alterneed Rest 1000&gt;&gt;
							&lt;&lt;alterneed Relaxation 1000&gt;&gt;
							&lt;&lt;alterneed Attention 1000&gt;&gt;
							&lt;&lt;alterneed Food 1000&gt;&gt;
							&lt;&lt;alterneed Bladder 1000&gt;&gt;
							&lt;&lt;alterneed Hygiene 1000&gt;&gt;
							&lt;&lt;alterneed Composure 1000&gt;&gt;
							&lt;&lt;alterneed Release 1000&gt;&gt;
							&lt;&lt;script&gt;&gt;
								Engine.show();
							&lt;&lt;/script&gt;&gt;
						&lt;&lt;/button&gt;&gt;
					&lt;/div&gt;
					&lt;div class="two-column"&gt;
						&lt;&lt;button &quot;Add $100&quot;&gt;&gt;
							&lt;&lt;money 100&gt;&gt;
							&lt;&lt;script&gt;&gt;
								Engine.show();
							&lt;&lt;/script&gt;&gt;
						&lt;&lt;/button&gt;&gt;
					&lt;/div&gt;
					&lt;div class="two-column"&gt;
						&lt;&lt;button &quot;Add $1000&quot;&gt;&gt;
							&lt;&lt;money 1000&gt;&gt;
							&lt;&lt;script&gt;&gt;
								Engine.show();
							&lt;&lt;/script&gt;&gt;
