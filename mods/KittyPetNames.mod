~~
Hey &lt;&lt;nickname $pc&gt;&gt;,&quot; &lt;&lt;firstname $eventnpc&gt;&gt; says sleepily when you pick up. &quot;I&#39;m about to crash here... just wanted to hear your voice first. Wanna... get in bed and stay on the phone as we drift off?&quot;
~
Hey &lt;&lt;if setup.people.get_person($eventnpc).playerpetname&gt;&gt;&lt;&lt;else&gt;&gt;nickname $pc&lt;&lt;if&gt;&gt;,&quot; &lt;&lt;firstname $eventnpc&gt;&gt; says sleepily when you pick up. &quot;I&#39;m about to crash here... just wanted to hear your voice first. Wanna... get in bed and stay on the phone as we drift off?&quot;
~~
setup.people.add_inclination = function(name, inclination)
{
    let pdata = this.get_person(name);
    if (!pdata.addinclinations)
        pdata.addinclinations = [];
    if (!pdata.addinclinations.includes(inclination))
        pdata.addinclinations.push(inclination);
    return pdata.addinclinations;
}
~
setup.people.add_inclination = function(name, inclination)
{
    let pdata = this.get_person(name);
    if (!pdata.addinclinations)
        pdata.addinclinations = [];
    if (!pdata.addinclinations.includes(inclination))
        pdata.addinclinations.push(inclination);
    return pdata.addinclinations;
}

setup.people.remove_inclination = function(name, inclination)
{
    let pdata = this.get_person(name);
    if (!pdata.addinclinations)
        pdata.addinclinations = [];
    if (pdata.addinclinations.includes(inclination))
        pdata.addinclinations.push(inclination);
		pdata.addinclinations = pdata.addinclinations.filter(item => item !== inclination);
    return pdata.addinclinations;
}
