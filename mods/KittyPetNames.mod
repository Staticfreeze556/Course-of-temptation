<tw-passagedata pid="120100" name="PetNamesConfig" tags="event" position="1225,13225" size="100,100">
&lt;&lt;nobr&gt;&gt;
	&lt;&lt;set _pobj to setup.people.get_person($eventnpc)&gt;&gt;

        Grant yourself a universal pet name:&lt;br&gt;
        &lt;&lt;set _petname to &quot;Pet Name&quot;&gt;&gt;
        &lt;span id=&quot;textbox-inclinationgranter&quot;&gt;
			&lt;&lt;textbox &quot;_petname&quot; $pc.petname&gt;&gt;
		&lt;/span&gt;
        &lt;&lt;script&gt;&gt;
            $(document).ready(function() {
            $(&#39;input[type=&quot;text&quot;]&#39;).attr(&#39;autocomplete&#39;, &#39;off&#39;);
            });
        &lt;&lt;/script&gt;&gt;
        &lt;&lt;button &quot;Grant&quot;&gt;&gt;
			&lt;&lt;set _petname to _petname.toLowerCase();&gt;&gt;
			&lt;&lt;set $pc.petname to _petname&gt;&gt;
			&lt;&lt;set $pcpetname to _petname&gt;&gt;
			&lt;&lt;goto &quot;PetNamesConfig&quot;&gt;&gt;
			Their new pet name is $pc.petname!
        &lt;&lt;/button&gt;&gt;
        &lt;span id=&quot;incresult&quot;&gt;&lt;/span&gt;
		
		&lt;br&gt;&lt;br&gt;
		
		Grant yourself a pet name:&lt;br&gt;
        &lt;&lt;set _petname to &quot;Pet Name&quot;&gt;&gt;
        &lt;span id=&quot;textbox-inclinationgranter&quot;&gt;
			&lt;&lt;textbox &quot;_petname&quot; _pobj.playerpetname&gt;&gt;
		&lt;/span&gt;
        &lt;&lt;script&gt;&gt;
            $(document).ready(function() {
            $(&#39;input[type=&quot;text&quot;]&#39;).attr(&#39;autocomplete&#39;, &#39;off&#39;);
            });
        &lt;&lt;/script&gt;&gt;
        &lt;&lt;button &quot;Grant&quot;&gt;&gt;
			&lt;&lt;set _petname to _petname.toLowerCase();&gt;&gt;
			&lt;&lt;set _pobj.playerpetname to _petname&gt;&gt;
			&lt;&lt;goto &quot;PetNamesConfig&quot;&gt;&gt;
			Their new pet name is _pobj.playerpetname!
        &lt;&lt;/button&gt;&gt;
        &lt;span id=&quot;incresult&quot;&gt;&lt;/span&gt;
		
		&lt;br&gt;&lt;br&gt;
		
		Grant &lt;&lt;po&gt;&gt; a pet name:&lt;br&gt;
        &lt;&lt;set _petname to &quot;Pet Name&quot;&gt;&gt;
        &lt;span id=&quot;textbox-inclinationgranter&quot;&gt;
			&lt;&lt;textbox &quot;_petname&quot; _pobj.mypetname&gt;&gt;
		&lt;/span&gt;
