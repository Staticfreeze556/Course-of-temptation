//#endregion Clothing Management

//#region Pet Name Management
	
	get_petname(speaker, type)
	{	
		let sdata = speaker.is_pc? speaker : setup.people.get_person(speaker);
		let exittext = "";
		
		if (V.pcpetname && !speaker.is_pc)
			{
				exittext = V.pcpetname;
			}
		else if (!speaker.is_pc)
			{
				if (sdata.playerpetname)
				{
					exittext = sdata.playerpetname;
				}
				else
				{
					exittext = "";
				}
			}
		else if (speaker.is_pc)
			{
				if (sdata.mypetname)
				{
					exittext = sdata.mypetname;
				}
				else
				{
					exittext = "";
				}
			}
			
		if (exittext != "")
		{
			switch (type) 
			{
				case 1:
					exittext = ' ' + exittext;
					break;
				case 2:
					exittext = exittext + ' ';
					break;
				case 3:
					exittext = exittext.charAt(0).toUpperCase() + exittext.slice(1) + ' ';
					break;
				case 4:
					exittext = exittext;
					break;
				default:
					exittext = exittext;
			}
		}
		return exittext;
	}
	
	set_petname(npc, player, petname, type) // &lt;&lt;run $pc.set_petname(_pobj, $pc, _petname, 1)&gt;&gt;
	{	
		petname = petname.toLowerCase();
		
		switch (type) 
		{
			case 1: // universal player pet name (all npc call player this)
				player.petname = petname;
				V.pcpetname = petname;
				break;
			case 2: // player pet name (npc call player this)
				npc.playerpetname = petname;
				break;
			case 3: // npc pet name (player call npc this)
				npc.mypetname = petname;
				break;
		}
	}
	
	
