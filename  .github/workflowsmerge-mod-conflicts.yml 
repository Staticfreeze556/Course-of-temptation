name: Merge Inspected Mods

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  merge:
    runs-on: windows-latest
    timeout-minutes: 5

    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Merge inspected original mods
        shell: pwsh
        run: |
          $ErrorActionPreference = 'Stop'

          @'
          import collections
          import hashlib
          import html
          import re
          import zipfile
          from pathlib import Path, PurePosixPath

          EXPECTED_GAME_VERSION = "v0.8.4d"
          EXPECTED_MOD_COUNT = 52
          MERGE_RULESET = "five-shared-groups-v1"

          source_zip = Path("input.mods/Mods.zip")
          game_path = Path("CourseOfTemptation.html")
          output_dir = Path("output/merged-mods")
          output_zip = output_dir / (
              f"merged-mods-{EXPECTED_GAME_VERSION}.zip"
          )
          report_path = output_dir / "MergeReport.txt"

          if not source_zip.is_file():
              raise SystemExit(
                  "Required original archive missing: input.mods/Mods.zip. "
                  "Complete the rename and inspection workflows first."
              )

          if not game_path.is_file():
              raise SystemExit(
                  "Required original HTML missing: CourseOfTemptation.html"
              )

          source_bytes = source_zip.read_bytes()
          game_bytes = game_path.read_bytes()
          source_hash = hashlib.sha256(source_bytes).hexdigest()
          game_hash = hashlib.sha256(game_bytes).hexdigest()

          game = game_path.read_text(encoding="utf-8-sig")
          decoded_game = html.unescape(game)

          version_pattern = (
              r'Config\.saves\.version\s*(?:=|to)\s*'
              r'["\'](v[^"\'\s<>]+)["\']'
          )
          versions = sorted(set(
              re.findall(version_pattern, decoded_game)
          ))

          if not versions:
              for match in list(re.finditer(
                  r'Config\.saves\.version', decoded_game
              ))[:5]:
                  excerpt = decoded_game[
                      max(0, match.start() - 80):match.end() + 160
                  ]
                  print("Version context:", repr(excerpt))
              raise SystemExit(
                  "Could not verify Config.saves.version. "
                  "No merged archive created."
              )

          if versions != [EXPECTED_GAME_VERSION]:
              raise SystemExit(
                  f"Current merge rules require {EXPECTED_GAME_VERSION}; "
                  f"found {versions}. Update the rules from the inspection "
                  "report before merging."
              )

          print(f"Verified original HTML version: {EXPECTED_GAME_VERSION}")
          print(f"Original archive: {source_zip.as_posix()}")
          print(f"Merge ruleset: {MERGE_RULESET}")

          records = {}

          with zipfile.ZipFile(source_zip) as archive:
              bad_file = archive.testzip()
              if bad_file is not None:
                  raise SystemExit(
                      f"Original ZIP integrity check failed at: {bad_file}"
                  )

              for info in archive.infolist():
                  if info.is_dir():
                      continue

                  name = info.filename.replace("\\", "/")
                  path = PurePosixPath(name)

                  if (
                      path.is_absolute()
                      or ".." in path.parts
                      or re.match(r"^[A-Za-z]:", name)
                  ):
                      raise SystemExit(f"Unsafe archive path: {name}")

                  if (
                      "__MACOSX" in path.parts
                      or path.name.startswith("._")
                  ):
                      continue

                  key = name.casefold()

                  if key in records:
                      raise SystemExit(
                          f"Duplicate case-insensitive archive path: {name}"
                      )

                  records[key] = {
                      "name": name,
                      "data": archive.read(info),
                  }

          mods = {}

          for key, record in records.items():
              if not record["name"].lower().endswith(".mod"):
                  continue

              raw = record["data"]
              text = raw.decode("utf-8-sig").replace("\r\n", "\n")

              if "\r" in text:
                  raise SystemExit(
                      f"Unexpected standalone carriage return: "
                      f"{record['name']}"
                  )

              mods[key] = {
                  "record": record,
                  "bom": raw.startswith(b"\xef\xbb\xbf"),
                  "newline": "\r\n" if b"\r\n" in raw else "\n",
                  "segments": text.split("~~"),
                  "changed": False,
              }

          if len(mods) != EXPECTED_MOD_COUNT:
              raise SystemExit(
                  f"Current merge rules expect {EXPECTED_MOD_COUNT} mod "
                  f"files; found {len(mods)}. Review the inspection report "
                  "and update the rules before merging."
              )

          by_basename = collections.defaultdict(list)

          for key, mod in mods.items():
              basename = PurePosixPath(
                  mod["record"]["name"]
              ).name.casefold()
              by_basename[basename].append(key)

          def find_mod(basename):
              matches = by_basename[basename.casefold()]

              if len(matches) != 1:
                  raise SystemExit(
                      f"Expected exactly one {basename}; "
                      f"found {len(matches)}."
                  )

              return matches[0]

          def entries():
              for key, mod in mods.items():
                  for index, segment in enumerate(mod["segments"]):
                      if "~" in segment:
                          old, new = segment.split("~", 1)
                          yield key, index, old.strip(), new.strip()

          changes = []
          changed_paths = set()
          effective_targets = []

          def merge_target(
              target,
              basenames,
              new_target=None,
              startup=False,
              helper=False,
          ):
              expected = [
                  find_mod(basename) for basename in basenames
              ]
              found = [
                  entry for entry in entries()
                  if entry[2] == target
              ]
              counts = collections.Counter(
                  entry[0] for entry in found
              )

              if (
                  set(counts) != set(expected)
                  or any(counts[key] != 1 for key in expected)
              ):
                  owners = [
                      mods[key]["record"]["name"]
                      for key, _, _, _ in found
                  ]
                  raise SystemExit(
                      f"Merge rule no longer matches the input for "
                      f"{target!r}. Owners found: {owners}. "
                      "Use the inspection report to update this rule."
                  )

              anchor = (
                  new_target if new_target is not None else target
              )
              match_count = game.count(anchor)

              if match_count != 1:
                  raise SystemExit(
                      f"Expected exactly one original HTML match for "
                      f"{anchor!r}; found {match_count}. "
                      "No candidate will be uploaded."
                  )

              lookup = {
                  entry[0]: entry for entry in found
              }
              tails = []

              for key in expected:
                  _, index, old, replacement = lookup[key]

                  if not replacement.startswith(old):
                      raise SystemExit(
                          "Replacement does not retain its expected "
                          f"anchor: {mods[key]['record']['name']}, "
                          f"{target!r}"
                      )

                  tail = replacement[len(old):].strip()

                  if not tail or "~" in tail:
                      raise SystemExit(
                          "Empty addition or unexpected separator in: "
                          f"{mods[key]['record']['name']}"
                      )

                  if startup:
                      tail = tail.replace(
                          "&lt;&lt;set $pclastresidence&gt;&gt;",
                          '&lt;&lt;set $pclastresidence to ""&gt;&gt;',
                      )

                  if helper and tail.rstrip().endswith("},"):
                      tail = tail.rstrip()[:-1] + ";"

                  tails.append(tail)

              combined = (
                  anchor + "\n\n" + "\n\n".join(tails)
              )
              keeper = expected[-1]

              for key in expected:
                  _, index, _, _ = lookup[key]
                  mod = mods[key]

                  mod["segments"][index] = (
                      "\n" + anchor + "\n~\n" + combined + "\n"
                      if key == keeper else ""
                  )

                  mod["changed"] = True
                  changed_paths.add(mod["record"]["name"])

              effective_targets.append(anchor)

              changes.append(
                  f"Original target: {target}\n"
                  f"Output anchor: {anchor}\n"
                  f"Combined mods: {', '.join(basenames)}\n"
                  f"Stored in: {mods[keeper]['record']['name']}\n"
                  f"Original HTML matches: {match_count}\n"
              )

          trio = [
              "KittyBuyOtherResidences.mod",
              "KittyPetNames.mod",
              "KittyPregnancyMod.mod",
          ]

          merge_target(
              "this.tattoos = {};",
              trio,
          )

          merge_target(
              "this.age = State.variables.pcage;",
              trio,
          )

          merge_target(
              "//#endregion Clothing Management",
              trio,
          )

          merge_target(
              "return [...new Set(inclins)];\n}",
              [
                  "KittyBuyOtherResidences.mod",
                  "KittyPregnancyMod.mod",
              ],
              helper=True,
          )

          obsolete_startup_target = (
              "&lt;&lt;set $pcage to 18&gt;&gt;"
          )
          startup_anchor = (
              "&lt;&lt;set $pcbirthday to "
              "setup.random_birthday()&gt;&gt;\n"
              "&lt;&lt;set $pcage to "
              "setup.minimum_pc_starting_age()&gt;&gt;"
          )

          merge_target(
              obsolete_startup_target,
              [
                  "KittyBuyOtherResidences.mod",
                  "KittyFollowers.mod",
                  "KittyGoOverAnybodysHouse.mod",
                  "KittyPetNames.mod",
                  "KittyPregnancyMod.mod",
              ],
              new_target=startup_anchor,
              startup=True,
          )

          remaining = list(entries())

          for target in effective_targets:
              count = sum(
                  old == target
                  for _, _, old, _ in remaining
              )

              if count != 1:
                  raise SystemExit(
                      f"Post-merge target validation failed for "
                      f"{target!r}: found {count} surviving entries."
                  )

          if any(
              old == obsolete_startup_target
              for _, _, old, _ in remaining
          ):
              raise SystemExit(
                  "Obsolete fixed-age startup target remains."
              )

          for key, mod in mods.items():
              if not mod["changed"]:
                  continue

              text = "~~".join(mod["segments"])
              text = text.replace("\n", mod["newline"])
              data = text.encode("utf-8")

              if mod["bom"]:
                  data = b"\xef\xbb\xbf" + data

              records[key]["data"] = data

          output_dir.mkdir(parents=True, exist_ok=True)

          with zipfile.ZipFile(
              output_zip,
              "w",
              compression=zipfile.ZIP_DEFLATED,
          ) as archive:
              for key in sorted(records):
                  record = records[key]
                  archive.writestr(
                      record["name"],
                      record["data"],
                  )

          with zipfile.ZipFile(output_zip) as archive:
              output_count = sum(
                  name.lower().endswith(".mod")
                  for name in archive.namelist()
              )

              bad_file = archive.testzip()

              if (
                  output_count != EXPECTED_MOD_COUNT
                  or bad_file is not None
              ):
                  raise SystemExit(
                      "Merged ZIP integrity or mod-count validation failed."
                  )

              for key, record in records.items():
                  if (
                      archive.read(record["name"])
                      != record["data"]
                  ):
                      raise SystemExit(
                          f"Output content mismatch: {record['name']}"
                      )

          if hashlib.sha256(
              source_zip.read_bytes()
          ).hexdigest() != source_hash:
              raise SystemExit(
                  "Original source ZIP unexpectedly changed."
              )

          if hashlib.sha256(
              game_path.read_bytes()
          ).hexdigest() != game_hash:
              raise SystemExit(
                  "Original HTML unexpectedly changed."
              )

          owners = collections.defaultdict(set)

          for key, index, old, new in remaining:
              owners[old].add(
                  mods[key]["record"]["name"]
              )

          shared = [
              (target, sorted(names))
              for target, names in owners.items()
              if len(names) > 1
          ]

          output_hash = hashlib.sha256(
              output_zip.read_bytes()
          ).hexdigest()

          report = [
              f"Merged candidate for original {EXPECTED_GAME_VERSION}",
              "",
              f"Merge ruleset: {MERGE_RULESET}",
              f"Original archive: {source_zip.as_posix()}",
              f"Original HTML: {game_path.as_posix()}",
              f"Merged candidate: {output_zip.as_posix()}",
              "",
              f"All {output_count} mod files retained.",
              "Original archive and HTML were not modified.",
              f"Shared target groups combined: {len(changes)}",
              f"Mod files changed: {len(changed_paths)}",
              f"Remaining shared targets across files: {len(shared)}",
              "",
              "Inspection prerequisite:",
              "- This action is manually started after inspection review.",
              "- It does not download or interpret the inspection report.",
              "- It rechecks the prerequisites of its configured merge rules.",
              "- Matching prerequisites do not prove the prior report used",
              "  these exact input bytes. Compare the hashes below.",
              "",
              "Explicit adjustments:",
              "- Startup retains the calculated starting age.",
              "- Bare pclastresidence initialization becomes an empty string.",
              "  This is an unset sentinel, not a validated hangout destination.",
              "- The helper rule changes a trailing comma to a semicolon.",
              "",
              "NOT repaired by this ruleset:",
              "- Monthly rent-call whitespace mismatch.",
              "- Missing rent-event registration anchor.",
              "- Calendar assignment/variable defect.",
              "- Rent state synchronization.",
              "- Mismatched rental-action strings.",
              "- Other failed residence location replacements.",
              "- Remaining shared targets and other mod failures.",
              "- Cheatplus syntax compatibility.",
              "- New issues identified in future inspection reports.",
              "",
              "No actual patcher execution or gameplay testing performed.",
              "This archive is a diagnostic candidate, not a verified working build.",
              "",
              f"Source ZIP SHA256: {source_hash}",
              f"Original HTML SHA256: {game_hash}",
              f"Merged ZIP SHA256: {output_hash}",
              "",
              "Changed files:",
              *sorted(changed_paths),
              "",
              "Merged groups:",
              "",
              *changes,
              "",
              "Remaining shared targets:",
          ]

          if shared:
              for target, names in shared:
                  preview = re.sub(r"\s+", " ", target)
                  if len(preview) > 160:
                      preview = preview[:160] + "..."
                  report.append(
                      f"- {preview!r}: {', '.join(names)}"
                  )
          else:
              report.append("- None in the ~~ / ~ parsed entries.")

          report_path.write_text(
              "\n".join(report) + "\n",
              encoding="utf-8",
          )

          print(
              f"Created candidate: {output_zip.as_posix()}; "
              f"{output_count} mods retained; "
              f"{len(changes)} groups merged; "
              f"{len(shared)} shared targets remain."
          )
          '@ | Set-Content -LiteralPath 'merge-inspected-mods.py' -Encoding utf8

          python merge-inspected-mods.py

          if ($LASTEXITCODE -ne 0) {
            throw 'Merge validation failed. No candidate from this run should be used.'
          }

          Get-Content -LiteralPath 'output/merged-mods/MergeReport.txt' -Raw |
            Add-Content -LiteralPath $env:GITHUB_STEP_SUMMARY

      - name: Upload merged candidate and merge report
        uses: actions/upload-artifact@v4
        with:
          name: Merged-Mods-Candidate-${{ github.run_number }}
          path: |
            output/merged-mods/merged-mods-v0.8.4d.zip
            output/merged-mods/MergeReport.txt
          if-no-files-found: error
